# GEMINI_API_KEY: Optional for live AI chat responses (falls back to deterministic HexaHive agent).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed website (used for canonical URLs, OpenGraph, and sitemap.xml)
APP_URL="https://hexahive.tech"

# Contact Form Lead Delivery (Resend Email API)
RESEND_API_KEY="re_placeholder_123456789"
CONTACT_NOTIFY_EMAIL="hello@hexahive.tech"
CONTACT_FROM_EMAIL="leads@hexahive.tech"

# Contact Form Lead Delivery (Google Sheets Apps Script / Webhook URL)
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Analytics (Optional — Plausible domain or GA4 Measurement ID)
VITE_PLAUSIBLE_DOMAIN="hexahive.tech"
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
